{
  "expo": {
    "name": "Faith & Family",
    "slug": "family-and-faith",
    "version": "2.1.3",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "faithandfamily",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FDF6E9",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.C323.faithandfamily",
      "buildNumber": "4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.C323.faithandfamily",
      "versionCode": 13,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "faithandfamily",
              "host": "rhythm",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FDF6E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDF6E9",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 96
          }
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#C99A3C"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Faith & Family uses the microphone for optional voice notes in the family journal.",
          "enableBackgroundPlayback": true,
          "recordAudioAndroid": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-localization",
      "expo-system-ui",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.swmansion.reanimated.** { *; }\n-keep class com.swmansion.worklets.** { *; }\n-keep class com.swmansion.gesturehandler.** { *; }\n-keep class com.swmansion.rnscreens.** { *; }\n-keep class com.facebook.react.turbomodule.** { *; }\n-keep class expo.modules.** { *; }\n"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fc964871-2945-46cf-a625-7e23b26e52db"
      }
    },
    "owner": "martyparker13",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/fc964871-2945-46cf-a625-7e23b26e52db"
    }
  }
}
